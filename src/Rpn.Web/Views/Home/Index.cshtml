@{ ViewData["Title"] = "Home"; }
<h1>RPN Workbench</h1>
<p>
    A calculator that reads expressions in Reverse Polish Notation. Operands first,
    then the operator: <code>3 4 +</code> is seven.
</p>
<p>Sign in to use the calculator and keep a history of what you have worked out.</p>
<p><a asp-controller="Calculator" asp-action="Index">Open the calculator</a></p>
